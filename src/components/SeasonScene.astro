---
// Build-time season, corrected at runtime by the inline script below.
const month = new Date().getMonth();
const season =
  month >= 2 && month <= 4 ? 'spring' : month <= 7 ? 'summer' : month <= 10 ? 'fall' : 'winter';
const label = { winter: 'Winter', spring: 'Spring', summer: 'Summer', fall: 'Fall' }[season];
---

<button
  type="button"
  class="season"
  data-season={season}
  aria-label={`${label} scene. Replay animation.`}
>
  <svg class="season__scene season__scene--winter" viewBox="0 0 48 32" aria-hidden="true" focusable="false">
    <path class="season__ground" d="M5 29h38"></path>
    <circle class="winter__flake" cx="13" cy="25" r="1.6" style="--dur: 1.5s"></circle>
    <circle class="winter__flake" cx="25" cy="21" r="1.2" style="--dur: 1.9s"></circle>
    <circle class="winter__flake" cx="36" cy="26" r="1.8" style="--dur: 1.3s"></circle>
  </svg>

  <svg class="season__scene season__scene--spring" viewBox="0 0 48 32" aria-hidden="true" focusable="false">
    <path class="season__ground" d="M5 29h38"></path>
    <path class="spring__stem" d="M24 29V17"></path>
    <g class="spring__bloom" fill="var(--color-accent)">
      <circle cx="24" cy="12" r="3.4"></circle>
      <circle cx="29" cy="16.8" r="3.4"></circle>
      <circle cx="19" cy="16.8" r="3.4"></circle>
      <circle cx="24" cy="16.8" r="1.9" fill="var(--color-bg)"></circle>
    </g>
  </svg>

  <svg class="season__scene season__scene--summer" viewBox="0 0 48 32" aria-hidden="true" focusable="false">
    <path class="season__ground" d="M5 29h38"></path>
    <g class="summer__rays" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round">
      <path d="M24 8.5V5.5"></path>
      <path d="M29.3 10.7 31.4 8.6"></path>
      <path d="M31.5 16h3"></path>
      <path d="M29.3 21.3 31.4 23.4"></path>
      <path d="M24 23.5v3"></path>
      <path d="M18.7 21.3 16.6 23.4"></path>
      <path d="M16.5 16h-3"></path>
      <path d="M18.7 10.7 16.6 8.6"></path>
    </g>
    <circle class="summer__sun" cx="24" cy="16" r="5.5"></circle>
  </svg>

  <svg class="season__scene season__scene--fall" viewBox="0 0 48 32" aria-hidden="true" focusable="false">
    <path class="season__ground" d="M5 29h38"></path>
    <g fill="var(--color-accent)">
      <g transform="translate(11 24) rotate(18)">
        <path class="fall__leaf" d="M-4 0q4-3 8 0-4 3-8 0Z" style="--dur: 1.7s"></path>
      </g>
      <g transform="translate(24 26) rotate(-12)">
        <path class="fall__leaf" d="M-4 0q4-3 8 0-4 3-8 0Z" style="--dur: 1.3s"></path>
      </g>
      <g transform="translate(36 23) rotate(32)">
        <path class="fall__leaf" d="M-4 0q4-3 8 0-4 3-8 0Z" style="--dur: 2s"></path>
      </g>
    </g>
  </svg>
</button>

<script>
  const season = document.querySelector<HTMLElement>('.season');

  if (season) {
    // Keep the scene in sync with the visitor's current season, not just the build date.
    const month = new Date().getMonth();
    season.dataset.season =
      month >= 2 && month <= 4 ? 'spring' : month <= 7 ? 'summer' : month <= 10 ? 'fall' : 'winter';

    season.addEventListener('click', () => {
      for (const animation of season.getAnimations({ subtree: true })) {
        animation.currentTime = Number(animation.effect?.getTiming().delay ?? 0);
        animation.play();
      }
    });
  }
</script>

<style>
  .season {
    --scene-delay: 1.2s;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .season:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  .season__scene {
    display: none;
    width: 100%;
    height: 100%;
  }

  .season[data-season='winter'] .season__scene--winter,
  .season[data-season='spring'] .season__scene--spring,
  .season[data-season='summer'] .season__scene--summer,
  .season[data-season='fall'] .season__scene--fall {
    display: block;
  }

  .season__scene * {
    animation-delay: var(--scene-delay);
    animation-fill-mode: both;
    transform-box: fill-box;
    transform-origin: center;
  }

  .season__ground {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.2;
    stroke-linecap: round;
    animation-name: season-fade;
    animation-duration: 0.8s;
  }

  .winter__flake {
    fill: var(--color-text);
    animation-name: season-fall;
    animation-duration: var(--dur, 1.5s);
    animation-timing-function: cubic-bezier(0.35, 0.6, 0.5, 1);
  }

  .spring__stem {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
    transform-origin: bottom;
    animation-name: season-grow;
    animation-duration: 0.9s;
    animation-timing-function: ease-out;
  }

  .spring__bloom,
  .summer__sun {
    animation-name: season-bloom;
    animation-duration: 1s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1.4);
  }

  .summer__sun {
    fill: var(--color-accent);
  }

  .summer__rays {
    fill: none;
    animation-name: season-rays;
    animation-duration: 1.4s;
    animation-timing-function: ease-out;
  }

  .fall__leaf {
    animation-name: season-fall;
    animation-duration: var(--dur, 1.7s);
    animation-timing-function: cubic-bezier(0.4, 0.1, 0.6, 1);
  }

  @keyframes season-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes season-fall {
    from {
      opacity: 0;
      transform: translate(-6px, -18px) rotate(-40deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes season-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: none;
    }
  }

  @keyframes season-bloom {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes season-rays {
    from {
      opacity: 0;
      transform: rotate(-50deg) scale(0.5);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .season__scene * {
      animation: none;
    }
  }
</style>
