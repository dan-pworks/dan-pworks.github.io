---
import BaseLayout from '../layouts/BaseLayout.astro';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Parra',
  jobTitle: 'Software Engineer',
  url: new URL('/', Astro.site ?? Astro.url.origin).href,
  sameAs: [
    'https://www.youtube.com/@parraworks',
    'https://www.linkedin.com/in/danpaji/',
    'https://x.com/DanParraWorks',
  ],
};

const tools = [
  { name: 'Code', path: 'M9 7l-5 5 5 5M15 7l5 5-5 5' },
  { name: 'Frameworks', path: 'M12 3l8 4.5-8 4.5-8-4.5L12 3zM4 12l8 4.5 8-4.5' },
  { name: 'Automation', path: 'M13 3L5 13h5l-1 8 8-10h-5l1-8z' },
];

const lanes = [
  { id: 'create', label: 'Create', badge: 'M12 5v14M5 12h14' },
  { id: 'modernize', label: 'Modernize', badge: 'M12 19V5M6 11l6-6 6 6' },
  { id: 'automate', label: 'Automate', badge: 'M5 12a7 7 0 0 1 12-5M17 4v3h-3' },
];

const techStack = [
  {
    title: 'Java & Spring Boot',
    icon: ['M5 8h11v6a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V8z', 'M16 9h1.5a2.5 2.5 0 0 1 0 5H16', 'M8 3v2M12 3v2'],
    summary:
      'The core of my backend work for 20+ years: Spring Boot microservices, Hibernate/JPA data layers, and REST APIs for enterprise reporting and integration platforms.',
  },
  {
    title: 'SQL & Data Platforms',
    icon: [
      'M3 5a9 3 0 0 1 18 0a9 3 0 0 1-18 0',
      'M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5',
      'M3 12c0 1.66 4 3 9 3s9-1.34 9-3',
    ],
    summary:
      'Modeling and tuning data across PostgreSQL, SQL Server, Teradata, and Netezza — from schema design to query performance on reporting workloads.',
  },
  {
    title: 'Databricks',
    icon: ['M12 2L2 7l10 5 10-5-10-5z', 'M2 12l10 5 10-5', 'M2 17l10 5 10-5'],
    summary:
      'My current focus: migrating a SaaS BI platform to Databricks and building Genie POCs that answer natural-language questions with real data.',
  },
  {
    title: 'Cloud & DevOps',
    icon: ['M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z'],
    summary:
      'Azure and Azure DevOps pipelines that automate build, test, and deployment, backed by Docker and Git across the delivery workflow.',
  },
  {
    title: 'JavaScript & TypeScript',
    icon: ['M8 6L2 12l6 6M16 6l6 6-6 6'],
    summary:
      'Typed web fundamentals — from MicroStrategy Web SDK extensions to React wrappers that streamline enterprise applications.',
  },
  {
    title: 'Python',
    icon: ['M4 17l6-6-6-6M12 19h8'],
    summary:
      'The glue language: scripting, data work, and automation that ties systems and AI-assisted workflows together.',
  },
  {
    title: 'Business Intelligence',
    icon: ['M6 20V10M12 20V4M18 20v-6'],
    summary:
      'Deep MicroStrategy platform experience — Web SDK customization, integrations, and reporting workflows for Fortune 500 clients.',
  },
  {
    title: 'Generative AI & Tools',
    icon: ['M12 3l1.7 7.3L21 12l-7.3 1.7L12 21l-1.7-7.3L3 12l7.3-1.7L12 3z'],
    summary:
      'Daily drivers: Copilot, OpenAI Codex, Claude Code, and OpenCode accelerating features, automating PR reviews, and streamlining CI/CD.',
  },
];
---

<BaseLayout
  title="Home"
  description="Daniel Parra is a software engineer building reliable, accessible web experiences."
>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />

  <section class="hero">
    <p class="eyebrow">Software Engineering</p>
    <h1>Building thoughtful Software for the Web.</h1>
    <p class="lede">
      I'm Daniel Parra, founder of Parra.Works. This website captures and represents what I do: designing and building reliable, accessible web experiences with a focus on clean architecture and the details that make products feel effortless. At Parra.Works, we are driven by generative AI, leveraging these tools to optimize workflows and implement effective solutions.
    </p>
  </section>

  <section class="stack" aria-labelledby="stack-title">
    <div class="stack__intro">
      <p class="eyebrow">Tech Stack</p>
      <h2 id="stack-title">The tools behind the work.</h2>
      <p class="lede">
        The technologies I reach for most — from enterprise Java backends to the generative AI tools in my daily workflow.
      </p>
    </div>

    <div
      class="stack__carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Tech stack highlights"
      data-stack-carousel
    >
      <button class="stack__nav" type="button" data-stack-prev aria-label="Previous tech stack tile">
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>

      <div class="stack__viewport">
        <ul class="stack__track" data-stack-track>
          {
            techStack.map((tech, index) => (
              <li
                class="stack__tile"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${techStack.length}`}
              >
                <div class="stack__tile-header">
                  <span class="stack__tile-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      {tech.icon.map((d) => (
                        <path d={d} />
                      ))}
                    </svg>
                  </span>
                  <span class="stack__tile-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3>{tech.title}</h3>
                </div>
                <div class="stack__tile-content">
                  <p>{tech.summary}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <button class="stack__nav" type="button" data-stack-next aria-label="Next tech stack tile">
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>

      <p class="stack__status" aria-live="polite" data-stack-status></p>
    </div>
  </section>

  <section class="flow" aria-labelledby="flow-title">
    <div class="flow__intro">
      <p class="eyebrow">How We build</p>
      <h2 id="flow-title">AI in the loop, craft in the output.</h2>
      <p class="lede">
        We pair generative AI with modern tools and frameworks to create new applications, modernize existing ones, and automate the work in between.
      </p>
    </div>

    <div class="flow__diagram">
      <div class="flow__core" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"></path>
        </svg>
        <span>AI</span>
      </div>

      <ul class="flow__lanes">
        {
          lanes.map((lane) => (
            <li class={`lane lane--${lane.id}`}>
              <span class="lane__label">{lane.label}</span>
              <span class="lane__track" aria-hidden="true">
                <span class="lane__dot"></span>
              </span>
              <span class="lane__tools" aria-hidden="true">
                {tools.map((tool) => (
                  <span class="chip" title={tool.name}>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={tool.path} />
                    </svg>
                  </span>
                ))}
              </span>
              <svg
                class="lane__arrow"
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 12h14M13 7l5 5-5 5" />
              </svg>
              <span class="lane__app" aria-hidden="true">
                <span class="app__bar app__bar--1"></span>
                <span class="app__bar app__bar--2"></span>
                <span class="app__bar app__bar--3"></span>
                <span class="app__badge">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={lane.badge} />
                  </svg>
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script>
    const carousel = document.querySelector<HTMLElement>('[data-stack-carousel]');

    if (carousel) {
      const track = carousel.querySelector<HTMLElement>('[data-stack-track]');
      const prev = carousel.querySelector<HTMLButtonElement>('[data-stack-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-stack-next]');
      const status = carousel.querySelector<HTMLElement>('[data-stack-status]');
      const tiles = track ? [...track.children] : [];
      const titles = tiles.map((tile) => tile.querySelector('h3')?.textContent ?? '');
      let index = 0;

      const show = (target: number): void => {
        index = (target + tiles.length) % tiles.length;
        if (track) track.style.transform = `translateX(-${index * 100}%)`;
        tiles.forEach((tile, i) => tile.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
        if (status) status.textContent = `${index + 1} of ${tiles.length}: ${titles[index]}`;
      };

      prev?.addEventListener('click', () => show(index - 1));
      next?.addEventListener('click', () => show(index + 1));
      show(0);
    }
  </script>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-content: center;
    padding-block: var(--space-24) var(--space-12);
    animation: fade-up 600ms ease both;
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: -0.04em;
  }

  .lede {
    margin: var(--space-6) 0 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .stack {
    padding-block: var(--space-12) var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .stack__intro {
    max-width: 70rem;
    margin-bottom: var(--space-12);
  }

  .stack__intro h2 {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
  }

  .stack__intro .lede {
    margin-top: var(--space-4);
  }

  .stack__carousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    width: 70%;
    margin-inline: auto;
  }

  .stack__nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }

  .stack__nav:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .stack__nav svg {
    width: 1rem;
    height: 1rem;
  }

  .stack__viewport {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .stack__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stack__tile {
    flex: 0 0 100%;
    display: grid;
    gap: var(--space-4);
    align-content: center;
    min-height: 14rem;
    padding: var(--space-8);
  }

  .stack__tile-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .stack__tile-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
    color: var(--color-accent);
  }

  .stack__tile-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .stack__tile-index {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .stack__tile-header h3 {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .stack__tile-content {
    max-width: var(--measure);
  }

  .stack__tile-content p {
    margin: 0;
    color: var(--color-muted);
  }

  .stack__status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .flow {
    padding-block: var(--space-12) var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .flow__intro {
    max-width: 50rem;
    margin-bottom: var(--space-12);
  }

  .flow__intro h2 {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
  }

  .flow__intro .lede {
    margin-top: var(--space-4);
  }

  .flow__diagram {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        circle at 6% 50%,
        color-mix(in srgb, var(--color-accent) 10%, transparent),
        transparent 55%
      ),
      var(--color-surface);
  }

  .flow__core {
    position: relative;
    display: grid;
    place-items: center;
    gap: var(--space-1);
    width: 5.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
  }

  .flow__core svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .flow__core::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-accent);
    border-radius: inherit;
    animation: pulse-ring 3.2s ease-out infinite;
  }

  .flow__lanes {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lane {
    display: grid;
    grid-template-columns: 6.5rem minmax(1.5rem, 1fr) auto auto auto;
    align-items: center;
    gap: var(--space-3);
  }

  .lane__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .lane__track {
    position: relative;
    height: 1px;
    background: var(--color-border);
  }

  .lane__dot {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    margin-top: -0.225rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0.5rem var(--color-accent);
    opacity: 0;
    transform: translateX(-50%);
    animation: travel 3.2s linear infinite;
  }

  .lane__tools {
    display: flex;
    gap: var(--space-2);
  }

  .chip {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    color: var(--color-muted);
    animation: chip 3.2s ease-in-out infinite;
  }

  .chip svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .lane__arrow {
    width: 1rem;
    height: 1rem;
    color: var(--color-border);
  }

  .lane__app {
    position: relative;
    display: grid;
    gap: 0.3rem;
    width: 5.5rem;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
  }

  .app__bar {
    height: 0.3rem;
    border-radius: 999px;
    background: var(--color-border);
  }

  .app__bar--1 {
    width: 70%;
  }

  .app__bar--2 {
    width: 100%;
  }

  .app__bar--3 {
    width: 45%;
  }

  .app__badge {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-bg);
    animation: pop 3.2s ease-in-out infinite;
  }

  .app__badge svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .lane:nth-child(2) :is(.lane__dot, .chip, .app__badge) {
    animation-delay: 0.5s;
  }

  .lane:nth-child(3) :is(.lane__dot, .chip, .app__badge) {
    animation-delay: 1s;
  }

  .lane--automate .app__badge svg {
    animation: spin 5s linear infinite;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse-ring {
    from {
      opacity: 0.6;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  @keyframes travel {
    0% {
      left: 0;
      opacity: 0;
    }

    10%,
    85% {
      opacity: 1;
    }

    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes chip {
    0%,
    45%,
    100% {
      border-color: var(--color-border);
      color: var(--color-muted);
    }

    60%,
    75% {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  @keyframes pop {
    0%,
    70%,
    100% {
      transform: scale(1);
    }

    80% {
      transform: scale(1.18);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 44rem) {
    .stack__carousel {
      width: 100%;
      gap: var(--space-2);
    }

    .stack__nav {
      width: 2.25rem;
    }

    .stack__tile {
      min-height: 12rem;
      padding: var(--space-6) var(--space-4);
    }

    .stack__tile-header {
      gap: var(--space-3);
    }

    .flow__diagram {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: var(--space-6) var(--space-4);
    }

    .flow__core {
      width: 4.5rem;
    }

    .lane {
      grid-template-columns: auto minmax(1rem, 1fr) auto auto;
      gap: var(--space-2);
    }

    .lane__label {
      font-size: 0.75rem;
    }

    .lane__arrow {
      display: none;
    }

    .lane__tools {
      gap: var(--space-1);
    }

    .chip {
      width: 1.25rem;
      height: 1.25rem;
    }

    .chip svg {
      width: 0.7rem;
      height: 0.7rem;
    }

    .lane__app {
      width: 3.5rem;
      padding: var(--space-2);
    }

    .app__badge {
      width: 1rem;
      height: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__core::after,
    .lane__dot {
      display: none;
    }

    .chip,
    .app__badge,
    .app__badge svg {
      animation: none;
    }
  }
</style>
