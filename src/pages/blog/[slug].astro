---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Daniel Parra' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="post">
    <header class="post__header">
      <a class="post__back" href="/blog">&larr; All posts</a>
      <p class="eyebrow">Blog</p>
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
        {post.data.tags.length > 0 && (
          <>
            {' · '}
            <span class="post__tags">{post.data.tags.join(' · ')}</span>
          </>
        )}
      </p>
    </header>

    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 46rem;
    margin-inline: auto;
    padding-block: var(--space-16) var(--space-24);
    animation: fade-up 600ms ease both;
  }

  .post__back {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .eyebrow {
    margin: var(--space-8) 0 var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
  }

  .post__meta {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .post__tags {
    font-family: var(--font-mono);
  }

  /* Rendered markdown isn't scoped by Astro, so descendants need :global() */
  .post-body :global(h2, h3) {
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .post-body :global(h2) {
    margin: var(--space-12) 0 var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xl);
  }

  .post-body :global(h3) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .post-body :global(p) {
    margin: var(--space-4) 0;
  }

  .post-body :global(ul, ol) {
    margin: var(--space-4) 0;
    padding-left: 1.5rem;
  }

  .post-body :global(li) {
    margin: var(--space-2) 0;
  }

  .post-body :global(li::marker) {
    color: var(--color-accent);
  }

  .post-body :global(a) {
    color: var(--color-accent);
  }

  .post-body :global(strong) {
    color: var(--color-text);
  }

  .post-body :global(code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .post-body :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .post-body :global(th, td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .post-body :global(th) {
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  @media (max-width: 40rem) {
    .post {
      padding-block: var(--space-8) var(--space-16);
    }

    .post-body :global(th, td) {
      padding: var(--space-1) var(--space-2);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
